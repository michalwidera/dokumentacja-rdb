// Rys. 37 - plan dedup.rql przed deduplicateSubstrats(), rysowany recznie.
//
// extractIntermediateStreams() wydziela substrat osobno dla str4 i str5, wiec plan ma dwa
// wezly o tej samej nazwie STREAM_ADD_core0_core1. xretractor -c -d tego nie pokaze nawet
// z RDB_OPT_DEDUP_SUBSTRATES=OFF: koncowe qTree::topologicalSort() indeksuje zapytania po
// nazwie i zlewa oba wezly w jeden. Styl wezlow jak w presenter::graphiz(), aby rysunek
// roznil sie od dedup_po.svg (Rys. 38) wylacznie zdublowanym substratem.
digraph structs {
 node	[shape=record];
 bgcolor="transparent";
 core0	[shape=record,style=filled,fillcolor="#FFF2CC",color=Black,label="core0\ninterval=1/10\nDeclaration"]
 core1	[shape=record,style=filled,fillcolor="#FFF2CC",color=Black,label="core1\ninterval=1/10\nDeclaration"]
 substrat_str4	[shape=record,style=filled,fillcolor=Sienna,color=Black,label="STREAM_ADD_core0_core1\ninterval=1/10, Auto"]
 substrat_str5	[shape=record,style=filled,fillcolor=Sienna,color=Black,label="STREAM_ADD_core0_core1\ninterval=1/10, Auto"]
 str4	[shape=record,style="filled",fillcolor=Gray,color=Black,label="str4\ninterval=1/10\norigin=2"]
 str5	[shape=record,style="filled",fillcolor=Gray,color=Black,label="str5\ninterval=1/10\norigin=3"]
substrat_str4 -> core0
substrat_str4 -> core1
substrat_str5 -> core0
substrat_str5 -> core1
str4 -> substrat_str4
str5 -> substrat_str5
}
